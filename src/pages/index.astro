---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import ProjectCarousel from "../components/projects_section/ProjectCarousel";
import BlogCarousel from "../components/post_section/BlogCarousel"; '../components/post_section/BlogCarousel';
import Contact from "../components/contact_section/Contact";
import About from "../components/about_section/About";

import { Image } from "astro:assets";

const allPosts = await Astro.glob("./posts/*.md");
---

<BaseLayout title="Frank Betancur">
  <section class="section-padding min-h-screen flex items-center" id="home">
    <div class="w-full">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <div class="profile-pic flex-shrink-0">
          <Image
            src={info.picture}
            alt={info.picture_alt}
            width={280}
            height={280}
            class="w-64 h-64 lg:w-80 lg:h-80 rounded-full object-cover shadow-soft-lg"
          />
        </div>

        <div class="flex-1 text-center lg:text-left space-y-6">
          <div class="space-y-4">
            <h1 class="text-4xl lg:text-6xl font-bold">
              Hi, I'm <span class="typewriter">
                {info.name}
              </span>
            </h1>
            <p class="text-xl lg:text-2xl text-text-secondary dark:text-dk-text-secondary font-medium">
              {info.brief_description}
            </p>
            <p class="text-lg text-text-secondary dark:text-dk-text-secondary">
              Based in <span class="text-accent dark:text-dk-accent font-medium">{info.location}</span>
            </p>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="#contact" class="btn btn-primary">
              Get In Touch
            </a>
            <a href="#about" class="btn btn-secondary">
              Learn More
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-padding" id="about">
    <About about={info.about} client:visible />
  </section>

  <section class="section-padding bg-secondary dark:bg-dk-secondary" id="tech">
    <ProjectCarousel projects={info.projects} client:only />
  </section>

  <section class="section-padding" id="blog">
    <BlogCarousel blogs={info.posts} client:only />
  </section>

  <section class="section-padding bg-secondary dark:bg-dk-secondary" id="contact">
    <div class="flex justify-center items-center">
      <Contact contact={info.contact} size="lg" />
    </div>
  </section>
</BaseLayout>

<style>
  .typewriter {
    background: linear-gradient(135deg, var(--color-accent), var(--color-text));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-shift 4s ease-in-out infinite;
    background-size: 200% 200%;
  }

  @keyframes gradient-shift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Shadow effect shifting through the image: inspired by https://codepen.io/davidicus/pen/emgQKJ */
  .profile-pic {
    position: relative;
    display: inline-block;
    overflow: hidden;
    border-radius: 100%;
  }

  .profile-pic::before {
    position: absolute;
    top: 0;
    left: -75%;
    z-index: 2;
    display: block;
    content: "";
    width: 50%;
    height: 100%;
    background: -webkit-linear-gradient(
      left,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 100%
    );
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 100%
    );
    -webkit-transform: skewX(-25deg);
    transform: skewX(-25deg);
  }
  .profile-pic:hover::before {
    -webkit-animation: shine 0.75s;
    animation: shine 0.75s;
  }
  @-webkit-keyframes shine {
    100% {
      left: 125%;
    }
  }
  @keyframes shine {
    100% {
      left: 125%;
    }
  }
</style>
