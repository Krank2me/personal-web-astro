---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  sizes?: string;
}

const { 
  src, 
  alt, 
  width = 800, 
  height = 600, 
  loading = 'lazy',
  class: className = '',
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  sizes={sizes}
  class={`transition-opacity duration-300 ${className}`}
  style="aspect-ratio: auto;"
/>

<style>
  img {
    max-width: 100%;
    height: auto;
  }
</style>
